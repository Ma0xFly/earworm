{
  "name": "earworm",
  "private": true,
  "version": "0.1.0",
  "description": "YouTube 双语字幕英语学习扩展：双语字幕、逐句复听、点词查词",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "wxt",
    "build": "wxt build && tsx scripts/verify-manifest.ts",
    "zip": "wxt zip",
    "postinstall": "wxt prepare",
    "typecheck": "wxt prepare && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "build:ecdict": "tsx scripts/build-ecdict.ts",
    "build:collocations": "tsx scripts/build-collocations.ts",
    "playground": "node scripts/playground.mjs"
  },
  "dependencies": {
    "class-variance-authority": "0.7.1",
    "clsx": "^2.1.1",
    "idb": "^8.0.3",
    "lucide-react": "1.79.0",
    "radix-ui": "1.8.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "^3.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.5",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/chrome": "0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "@wxt-dev/module-react": "1.2.2",
    "fake-indexeddb": "^6.2.4",
    "happy-dom": "21.0.4",
    "shadcn": "4.23.0",
    "tailwindcss": "4.3.5",
    "tsx": "^4.20.6",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vitest": "5.1.1",
    "wxt": "0.21.5"
  }
}
